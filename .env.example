# Recherche läuft über dein Claude-Abo (claude CLI, eingeloggt). Kein API-Key nötig.
# Optional: Modell für "Schnell" / "Gründlich"
RESEARCH_MODEL_FAST=sonnet
RESEARCH_MODEL_THOROUGH=opus

# Optional: AI-Musikgenerator (ElevenLabs Music, bezahlter Plan)
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2_5

API_PORT=8790
