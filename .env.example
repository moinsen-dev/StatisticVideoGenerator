# Recherche läuft über dein Claude-Abo (claude CLI, eingeloggt). Kein API-Key nötig.
# Optional: Modell für "Schnell" / "Gründlich"
RESEARCH_MODEL_FAST=sonnet
RESEARCH_MODEL_THOROUGH=opus

# Optional: AI-Musikgenerator (ElevenLabs Music, bezahlter Plan)
ELEVENLABS_API_KEY=
ELEVENLABS_MUSIC_MODEL=music_v2_5

# Optional: öffentliche Galerie lokal (SQLite in .data/). Prüfung über die claude CLI, Mails nur in der Konsole.
# Ohne ADMIN_TOKEN gilt lokal das Token "local". Gehostet: Secrets ANTHROPIC_API_KEY und RESEND_API_KEY im Pages-Projekt.
ADMIN_TOKEN=
RATE_SALT=

API_PORT=8790
